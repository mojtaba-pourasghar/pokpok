# Cloudflare Workers AI — only for tools/art/generate_cf.py (image generation). Never shipped in the app.
# Account ID: Cloudflare dashboard → Workers & Pages → Overview (right sidebar), 32 hex characters.
# API Token:  My Profile → API Tokens → Create Token with "Workers AI: Read" (Run) permission.
CF_ACCOUNT_ID=your_32_character_account_id
CF_API_TOKEN=your_cloudflare_api_token
