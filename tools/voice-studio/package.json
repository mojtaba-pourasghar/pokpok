{
  "name": "popo-voice-studio",
  "version": "1.0.0",
  "private": true,
  "description": "استودیوی صداگذاری پوپو — صدای گوینده (آواشو، موقت) و صدای واقعیِ حیوان‌ها و وسایل را مستقیم داخل پروژه می‌گذارد",
  "type": "module",
  "scripts": {
    "start": "vite build && node server/index.js",
    "server": "node server/index.js",
    "dev": "concurrently -n server,web -c yellow,cyan \"node server/index.js\" \"vite\"",
    "build": "vite build"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18"
  }
}
